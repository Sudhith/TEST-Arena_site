# ─────────────────────────────────────────────────────────────
# CAPTCHA Solver Testbed — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Required: random secret used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Database URL.
# Default: SQLite (local/dev only — data is lost on Render free-tier restarts).
# For durable production deployments, set to a free Postgres URL, e.g.:
#   Neon:     postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/captchadb
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./captcha_testbed.db

# Rate limit for CAPTCHA API endpoints (slowapi syntax).
# Examples: "30/minute", "100/hour"
RATE_LIMIT=30/minute

# Environment tag (development | production)
ENVIRONMENT=development
